# Copy this file to k8s/secrets.yaml and adjust values, then:
#   kubectl apply -f k8s/secrets.yaml
#
# k8s/secrets.yaml is gitignored — never commit real credentials.
#
# Defaults match docker-compose.yml (postgres/postgres, product/product)
# because order-service, Keycloak, and product-service have those hardcoded
# in application.properties for the prod profile — see k8s/README.md
# "Secrets". Change only if you also change (or override via env) that app
# config.
apiVersion: v1
kind: Secret
metadata:
  name: shopflow-secrets
  namespace: shopflow
type: Opaque
stringData:
  POSTGRES_USER: postgres
  POSTGRES_PASSWORD: postgres
  MONGO_USER: product
  MONGO_PASSWORD: product
  KEYCLOAK_ADMIN: admin
  KEYCLOAK_ADMIN_PASSWORD: admin
