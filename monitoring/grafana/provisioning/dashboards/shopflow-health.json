{
  "title": "ShopFlow — 4. System Health",
  "uid": "shopflow-health",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "panels": [

    { "id": 100, "type": "row", "title": "Infrastructure Health", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 1, "type": "timeseries", "title": "Outbox Pending",
      "gridPos": { "x": 0, "y": 1, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "custom": { "lineWidth": 2, "fillOpacity": 20 }, "unit": "short" } },
      "targets": [{ "expr": "outbox_pending{job=\"order-service\"}", "legendFormat": "pending rows" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Duplicate Events Blocked",
      "gridPos": { "x": 8, "y": 1, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "custom": { "lineWidth": 2 }, "unit": "short" } },
      "targets": [{ "expr": "inbox_duplicates_total{job=\"order-service\"}", "legendFormat": "total blocked" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "DLQ Event Count",
      "gridPos": { "x": 16, "y": 1, "w": 8, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" } },
      "targets": [
        { "expr": "kafka_topic_partition_current_offset{topic=~\".*-dlq\"}", "legendFormat": "{{topic}}" }
      ]
    },

    { "id": 101, "type": "row", "title": "JVM & HTTP Rates", "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 4, "type": "timeseries", "title": "JVM Heap Usage",
      "gridPos": { "x": 0, "y": 10, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "bytes" } },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "used" },
        { "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})", "legendFormat": "max" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "GC Pause Time",
      "gridPos": { "x": 6, "y": 10, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "s" } },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum[1m])", "legendFormat": "{{action}} — {{cause}}" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "HTTP Request Rate",
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "reqps" } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"gateway\"}[1m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Error Rate (5xx)",
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "custom": { "lineWidth": 2, "fillOpacity": 20 }, "unit": "reqps", "min": 0, "max": 0.3 } },
      "targets": [
        { "expr": "sum(rate(http_server_requests_seconds_count{job=\"gateway\",status=~\"5..\"}[1m]))", "legendFormat": "5xx/s" }
      ]
    }

  ]
}