{
  "title": "ShopFlow — 1. Saga & Orders",
  "uid": "shopflow-saga",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "timezone": "browser",
  "panels": [

    { "id": 100, "type": "row", "title": "Saga Counters", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 1, "type": "stat", "title": "Orders Created",
      "gridPos": { "x": 0, "y": 1, "w": 5, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "unit": "short" } },
      "targets": [{ "expr": "orders_created_total{job=\"order-service\"}", "legendFormat": "total" }]
    },
    {
      "id": 2, "type": "stat", "title": "Sagas Completed",
      "gridPos": { "x": 5, "y": 1, "w": 5, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "unit": "short" } },
      "targets": [{ "expr": "sagas_completed_total{job=\"order-service\",outcome=\"COMPLETED\"}", "legendFormat": "completed" }]
    },
    {
      "id": 3, "type": "stat", "title": "Sagas Failed",
      "gridPos": { "x": 10, "y": 1, "w": 5, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" } },
      "targets": [{ "expr": "sagas_completed_total{job=\"order-service\",outcome=\"CANCELLED\"}", "legendFormat": "failed" }]
    },
    {
      "id": 4, "type": "stat", "title": "Sagas Compensated",
      "gridPos": { "x": 15, "y": 1, "w": 5, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short" } },
      "targets": [{ "expr": "sagas_compensated_total{job=\"order-service\"}", "legendFormat": "compensated" }]
    },
    {
      "id": 5, "type": "stat", "title": "Sagas Timed Out",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "yellow" }, "unit": "short" } },
      "targets": [{ "expr": "sagas_timed_out_total{job=\"order-service\"}", "legendFormat": "timed out" }]
    },

    { "id": 101, "type": "row", "title": "Saga Health", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 6, "type": "timeseries", "title": "Sagas: Started vs Completed vs Failed",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "started" },   "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "completed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "expr": "orders_created_total{job=\"order-service\"}", "legendFormat": "started" },
        { "expr": "sagas_completed_total{job=\"order-service\",outcome=\"COMPLETED\"}", "legendFormat": "completed" },
        { "expr": "sagas_completed_total{job=\"order-service\",outcome=\"CANCELLED\"}", "legendFormat": "failed" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Saga Success Rate",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "lineWidth": 2 }, "unit": "percent", "min": 0, "max": 100 } },
      "targets": [
        { "expr": "100 * sum(sagas_completed_total{job=\"order-service\",outcome=\"COMPLETED\"}) / sum(sagas_completed_total{job=\"order-service\"})", "legendFormat": "success %" }
      ]
    },

    { "id": 102, "type": "row", "title": "Saga Duration & Rate", "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 8, "type": "timeseries", "title": "Average Saga Duration", "description": "Rolling 10-minute average. Each point shows the mean saga completion time across all sagas that finished in the preceding 10 minutes.",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 }, "unit": "s" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "avg completed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "avg failed" },    "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "targets": [
        { "expr": "rate(saga_duration_seconds_sum{job=\"order-service\",outcome=\"COMPLETED\"}[10m]) / rate(saga_duration_seconds_count{job=\"order-service\",outcome=\"COMPLETED\"}[10m])", "legendFormat": "avg completed" },
        { "expr": "rate(saga_duration_seconds_sum{job=\"order-service\",outcome=\"CANCELLED\"}[10m]) / rate(saga_duration_seconds_count{job=\"order-service\",outcome=\"CANCELLED\"}[10m])", "legendFormat": "avg failed" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "Order Creation Rate (last 5 min)",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "options": { "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" }, "custom": { "lineWidth": 2, "fillOpacity": 10 }, "unit": "short" } },
      "targets": [
        { "expr": "increase(orders_created_total{job=\"order-service\"}[5m])", "legendFormat": "orders in last 5m" }
      ]
    }

  ]
}